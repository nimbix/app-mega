{
    "name": "The Mega App v2",
    "description": "An app to test them all",
    "author": "Benoit Leveugle",
    "licensed": false,
    "appdefversion": 2,
    "classifications": [
        "test"
    ],
    "machines": [
        "n*"
    ],
    "appkind": "k8s",
    "vault-types": [
        "FILE",
        "BLOCK",
        "BLOCK_ARRAY",
        "OBJECT"
    ],
    "commands": {
        "custom": {
            "path": "/usr/bin/echo",
            "interactive": false,
            "publicip": false,
            "name": "custom",
            "description": "Basic shell variables expansion",
            "verboseinit": true,
            "parameters": {
                "color": {
                    "name": "What to echo",
                    "description": "What to echo",
                    "type": "STR",
                    "value": "blue",
                    "positional": true,
                    "variable": false,
                    "required": true
                }
            }
        },
        "Shell_expansion": {
            "path": "/bin/echo",
            "interactive": false,
            "publicip": false,
            "name": "Shell Expansion",
            "description": "Basic shell variables expansion",
            "parameters": {
                "message1": {
                    "name": "message1",
                    "description": "value1",
                    "type": "CONST",
                    "value": "Hello ! I am $(hostname).",
                    "positional": true,
                    "required": true
                },
                "message2": {
                    "name": "message2",
                    "description": "value2",
                    "type": "CONST",
                    "value": "And I like $(color) color.",
                    "positional": true,
                    "required": true
                },
                "color": {
                    "name": "The color",
                    "description": "Set node liked color",
                    "type": "STR",
                    "value": "yellow",
                    "variable": true,
                    "required": true
                }
            }
        },
        "Shell_expansion_with_conditions": {
            "path": "/bin/echo",
            "interactive": false,
            "publicip": false,
            "name": "Shell Expansion with conditions",
            "description": "Test conditions",
            "parameters": {
                "message1": {
                    "name": "message1",
                    "description": "value1",
                    "type": "CONST",
                    "value": "Hello ! I am $(hostname).",
                    "positional": true,
                    "required": true
                },
                "message2": {
                    "name": "message2",
                    "description": "value2",
                    "type": "CONST",
                    "value": "And I like $(color1)$(color2) color.",
                    "positional": true,
                    "required": true
                },
                "color1": {
                    "name": "First color",
                    "description": "Set node liked color",
                    "type": "STR",
                    "value": "yellow",
                    "variable": true,
                    "if": [
                        "color_select"
                    ],
                    "required": true
                },
                "color2": {
                    "name": "Second color",
                    "description": "Set node liked color",
                    "type": "STR",
                    "value": "black",
                    "variable": true,
                    "ifnot": [
                        "color_select"
                    ],
                    "required": true
                },
                "color_select": {
                    "name": "Do we use first color ?",
                    "description": "Specify it using first color. If not, second will be used.",
                    "type": "BOOL",
                    "value": true,
                    "required": true
                }
            }
        },
        "Script_raw": {
            "path": "/myscript.sh",
            "interactive": false,
            "name": "Script Raw",
            "description": "Run a raw script",
            "cmdscript": "#!/bin/sh\necho I love pizza\necho $(ps -ax)",
            "parameters": {}
        },
        "convert_video": {
            "path": "/usr/bin/ffmpeg",
            "interactive": false,
            "name": "Convert video",
            "description": "Convert a video in /data/input.mkv to /data/output.mkv",
            "parameters": {
                "p1": {
                    "name": "p1",
                    "description": "p1",
                    "type": "CONST",
                    "value": "-i",
                    "positional": true,
                    "required": true
                },
                "p2": {
                    "name": "p2",
                    "description": "p2",
                    "type": "CONST",
                    "value": "/data/input.mkv",
                    "positional": true,
                    "required": true
                },
                "p3": {
                    "name": "p3",
                    "description": "p3",
                    "type": "CONST",
                    "value": "-vcodec",
                    "positional": true,
                    "required": true
                },
                "p4": {
                    "name": "p4",
                    "description": "p4",
                    "type": "CONST",
                    "value": "libx264",
                    "positional": true,
                    "required": true
                },
                "p5": {
                    "name": "p5",
                    "description": "p5",
                    "type": "CONST",
                    "value": "/data/output.mkv",
                    "positional": true,
                    "required": true
                },
                "p6": {
                    "name": "p6",
                    "description": "p6",
                    "type": "CONST",
                    "value": "-n",
                    "positional": true,
                    "required": true
                }
            }
        },
        "delete_converted_video": {
            "path": "/myscript.sh",
            "interactive": false,
            "name": "Delete converted video",
            "description": "Delete /data/output.mkv",
            "cmdscript": "#!/bin/bash\nset -o pipefail\ntest -f /data/output.mkv && rm -f /data/output.mkv || exit 1",
            "parameters": {}
        },
        "Script_base64": {
            "path": "/myscript.sh",
            "interactive": false,
            "name": "Script Base64",
            "description": "Run a raw script (bash for loop that says hello 5 time)",
            "cmdscript": "IyEvYmluL2Jhc2gKZm9yIGkgaW4gMSAyIDMgNCA1CmRvCiAgIGVjaG8gIldlbGNvbWUgJGkgdGltZXMiCmRvbmUK",
            "parameters": {}
        },
        "Mpi_imb_bench": {
            "path": "/IMB-MPI1",
            "interactive": false,
            "verboseinit": true,
            "name": "MPI Benchmark IMB",
            "mpirun": true,
            "description": "Run a basic IMB MPI1 benchmark",
            "parameters": {}
        },
        "Mpi_hello_world": {
            "path": "/usr/bin/hostname",
            "interactive": false,
            "verboseinit": true,
            "name": "MPI Hello World",
            "mpirun": true,
            "description": "Run a basic MPI hello world via hostname",
            "parameters": {}
        },
        "Mpi_osu_bw": {
            "path": "/osu_bw",
            "interactive": false,
            "verboseinit": true,
            "name": "MPI Benchmark OSU BW",
            "mpirun": true,
            "description": "Run a bandwith osu benchmark",
            "parameters": {}
        },
        "Mpi_osu_latency": {
            "path": "/osu_latency",
            "interactive": false,
            "verboseinit": true,
            "name": "MPI Benchmark OSU LAT",
            "mpirun": true,
            "description": "Run a latency osu benchmark",
            "parameters": {}
        },
        "Gotty_Bash": {
            "path": "/bin/bash -l",
            "webshell": true,
            "interactive": false,
            "publicip": false,
            "name": "Gotty Bash",
            "description": "Start a gotty shell",
            "parameters": {}
        },
        "GUI_Gimp_Desktop": {
            "path": "/usr/bin/gimp",
            "interactive": false,
            "desktop": true,
            "name": "GUI Gimp Desktop",
            "description": "Run a GIMP in a GUI desktop, and connect interactively directly from your web browser (requires Nimbix Desktop in image).",
            "parameters": {}
        }
    },
    "image": {
	    "data": "",
        "type": "image/png"
    }
}

